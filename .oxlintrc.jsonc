{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-hooks"],
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true,
    "browser": true,
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
  },
  "rules": {
    "no-unused-vars": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",

    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",

    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",

    // Falso positivo conhecido: os setState deste arquivo acontecem depois de
    // `await fetch(...)`, ou seja, em microtask, nunca sincronamente no effect.
    "react/set-state-in-effect": "off",

    // Regra obsoleta. Com o JSX transform automatico (`"jsx": "react-jsx"` no
    // tsconfig) nao e necessario `import React`.Ela gerava 282 dos 395 avisos,
    // todos falso, e treinar quem lê o output a ignorar avisos.
    "react/react-in-jsx-scope": "off",

    // Accessa `dados.profil[campo]` em objetos vindos da API como
    // `Record<string, unknown>`. some com a tipagem das respostas (Fase 3/6).
    "no-underscore-dangle": "off",

    // Falso positivo: o oxlint aplica regras do Express ao Fastify. O Fastify
    // lida com promises rejeitadas automaticamente, entao async handlers sao seguros.
    "oxc/no-async-endpoint-handlers": "off",

    // O projeto usa loops sequenciais para migracoes, seed e transacoes de banco.
    // Nesses casos, `await` dentro de loop e intencional e necessario.
    "eslint/no-await-in-loop": "off",

    // Spreads em map sao usados para criar novos objetos sem mutar o original.
    // E um padrao comum e seguro no projeto.
    "oxc/no-map-spread": "off",

    // Type assertions sao necessarios para o pg (PostgreSQL) que retorna `any`.
    // O projeto usa `as unknown as` para type assertions mais seguras.
    "typescript/no-unsafe-type-assertion": "off",

    // Promises sao intencionalmente nao aguardadas em alguns casos (ex: logout).
    // O projeto usa `void` para marcar promises intencionalmente nao aguardadas.
    "typescript/no-floating-promises": "off",

    // Template literals com valores possivelmente null/undefined sao usados
    // em mensagens de erro. O projeto garante que os valores sao seguros.
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off",
  },
  "ignorePatterns": [
    "build",
    "dist",
    "coverage",
    ".cache",
    ".local",
    "node_modules",
    "**/node_modules",
    "**/dist",
    "**/coverage",
    "database",
  ],
}
