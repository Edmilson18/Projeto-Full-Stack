{
  "name": "loja-tech",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @loja/api",
    "dev:web": "npm run dev -w @loja/web",
    "clean": "node -e \"const{rmSync}=require('node:fs');for(const d of['build','apps/api/dist','apps/api/coverage','apps/web/dist','coverage'])rmSync(d,{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:legacy && npm run build -w @loja/api && npm run build -w @loja/web",
    "build:legacy": "tsc -p legacy/tsconfig.json",
    "start": "npm run start -w @loja/api",
    "db:init": "npm run db:init -w @loja/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @loja/api",
    "test:watch": "npm run test:watch -w @loja/api",
    "test:coverage": "npm run test:coverage -w @loja/api",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
