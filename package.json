{
  "name": "loja-tech",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @loja/api",
    "dev:web": "npm run dev -w @loja/web",
    "build": "npm run build -w @loja/shared && npm run build -w @loja/api && npm run build -w @loja/web",
    "start": "npm run start -w @loja/api",
    "db:setup": "npm run db:setup -w @loja/api",
    "db:migrate": "npm run db:migrate -w @loja/api",
    "db:seed": "npm run db:seed -w @loja/api",
    "db:reset": "npm run db:reset -w @loja/api",
    "typecheck": "npm run build -w @loja/shared && npm run typecheck --workspaces --if-present",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build -w @loja/shared && npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
