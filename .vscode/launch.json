{
  // Depuracao dos dois processos de `npm run dev`:
  //   - API em http://localhost:3000
  //   - Vite em http://localhost:5173
  //
  // Execute `npm run dev` antes de abrir a configuração do navegador.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Abrir loja no navegador (Vite)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Depurar API (tsx src/server.ts)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "src/server.ts"],
      "cwd": "${workspaceFolder}/apps/api",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Executar testes dos workspaces",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
