{
  // Depuracao dos dois processos de `npm run dev`:
  //   - API em http://localhost:3000
  //   - Vite em http://localhost:5173
  //
  // Substitui a configuracao anterior, que apontava para a porta 8080, onde nada
  // rodava. As configuracoes ficam em compound para_os dois subindo juntos.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Abrir loja no navegador (Vite)",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Depurar API (tsx src/server.ts)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "src/server.ts"],
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Executar testes uma vez (vitest run)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vitest", "run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
