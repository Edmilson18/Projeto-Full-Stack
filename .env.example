# Ambiente. "development" imprime o link de redefinicao de senha no console.
# "production" omite o token da resposta da API. Defina sempre: sem este valor o
# padrao e "development", e o token vaza na resposta.
NODE_ENV=development

PORT=3000

# Caminho do arquivo SQLite, relativo a raiz do projeto. Vazio usa
# database/loja.db. A suite de testes sobrescreve este valor para .tmp/teste.db,
# para nao tocar no banco de desenvolvimento — nao precisa ser definido aqui.
DATABASE_FILE=

# Usado a partir da Fase 4, quando o projeto migra de SQLite para PostgreSQL.
# Livre: https://neon.tech (0,5 GB, sem cartao de credito).
DATABASE_URL=

# Transacional (Fase 10). Vazio = desativado.
MAILTRAP_API_KEY=
MAIL_FROM=
APP_URL=http://localhost:3000
