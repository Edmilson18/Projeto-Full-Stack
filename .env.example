# Ambiente. "development" imprime o link de redefinicao de senha no console.
# "production" omite o token da resposta da API. Defina sempre: sem este valor o
# padrao e "development", e o token vaza na resposta.
NODE_ENV=development

PORT=3000

# PostgreSQL. O padrao aponta para o container do docker-compose.yml, que sobe
# com `docker compose up -d`. Em producao use a URL do Neon, que exige
# DATABASE_SSL=true.
DATABASE_URL=postgresql://loja:loja_local_dev@localhost:5433/loja
DATABASE_SSL=false

# Schema usado nas consultas. Padrao "public". A suite de testes cria um schema
# proprio por execucao e sobrescreve esta variavel; nao defina manualmente.
DATABASE_SCHEMA=public

# COOKIE_SECRET nao e mais lido: a sessao nao assina cookie (ver README).
# A variavel foi removida do .env, do compose e do codigo.

# Origem do frontend, usada na verificacao de Origin das rotas que alteram dados.
APP_URL=http://localhost:3000

# Senha do administrador criado por `db:setup`/`db:seed` quando ele ainda nao
# existe. Obrigatoria em producao. Em desenvolvimento o padrao e "admin123".
ADMIN_PASSWORD=

# Libera `npm run db:reset` quando NODE_ENV=production. Mesmo com esta variavel,
# o comando so aceita um DATABASE_URL local (localhost/127.0.0.1).
ALLOW_DB_RESET=false

# Endpoint do Vite contra a API no `npm run dev`. Padrao http://localhost:3000.
VITE_API_URL=http://localhost:3000

# Envios de e-mail. Nenhum modulo do projeto le estas variaveis hoje: sao o
# espaco reservado para o servico de recuperacao de senha. Sem elas,
# /api/recuperar-senha responde com o token no corpo (apenas em desenvolvimento).
MAILTRAP_API_KEY=
MAIL_FROM=
